{
  "name": "sharepoint-devtools",
  "version": "1.0.0",
  "description": "Keyboard-driven navigation and metadata inspectors for SharePoint Online",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.dev.js",
    "watch": "webpack --config webpack.dev.js --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:e2e": "node tests/e2e/run.js",
    "seed:dev": "node tools/seed-dev-tenant.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepReef11/sharepoint-devtools.git"
  },
  "keywords": [
    "sharepoint",
    "chrome-extension",
    "browser-extension",
    "navigation",
    "productivity",
    "fuzzy-search",
    "developer-tools",
    "sharepoint-online"
  ],
  "author": "DeepReef11",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/chrome": "^0.1.30",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.2.0",
    "playwright-core": "^1.62.0",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "fuse.js": "^7.0.0"
  },
  "bugs": {
    "url": "https://github.com/DeepReef11/sharepoint-devtools/issues"
  },
  "homepage": "https://github.com/DeepReef11/sharepoint-devtools#readme",
  "private": false
}
